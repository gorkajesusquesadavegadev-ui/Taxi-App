{
  "expo": {
    "name": "CanaryCab",
    "slug": "canarycab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFC400"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.canarycab.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CanaryCab usa tu ubicación para mostrarte taxis cercanos y calcular rutas."
      }
    },
    "android": {
      "package": "com.canarycab.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFC627",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CanaryCab usa tu ubicación para mostrarte taxis cercanos y calcular rutas."
        }
      ],
      "expo-font"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "79ef9ffc-e5fb-429f-974f-10ca7b824131"
      }
    },
    "owner": "gorkaexpogo"
  }
}
