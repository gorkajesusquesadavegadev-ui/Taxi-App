{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/tarifas-taxi-gran-canaria",
      "destination": "/tarifas-taxi-gran-canaria.html"
    },
    {
      "source": "/taxi-aeropuerto-las-palmas",
      "destination": "/taxi-aeropuerto-las-palmas.html"
    },
    {
      "source": "/taxi-aeropuerto-maspalomas",
      "destination": "/taxi-aeropuerto-maspalomas.html"
    },
    {
      "source": "/taxi-aeropuerto-puerto-mogan",
      "destination": "/taxi-aeropuerto-puerto-mogan.html"
    },
    {
      "source": "/taxi-aeropuerto-puerto-rico",
      "destination": "/taxi-aeropuerto-puerto-rico.html"
    },
    {
      "source": "/taxi-airport-las-palmas",
      "destination": "/taxi-airport-las-palmas.html"
    },
    {
      "source": "/taxi-airport-maspalomas",
      "destination": "/taxi-airport-maspalomas.html"
    },
    {
      "source": "/taxi-airport-puerto-mogan",
      "destination": "/taxi-airport-puerto-mogan.html"
    },
    {
      "source": "/taxi-airport-puerto-rico",
      "destination": "/taxi-airport-puerto-rico.html"
    },
    {
      "source": "/taxi-fares-gran-canaria",
      "destination": "/taxi-fares-gran-canaria.html"
    },
    {
      "source": "/taxi-flughafen-las-palmas",
      "destination": "/taxi-flughafen-las-palmas.html"
    },
    {
      "source": "/taxi-flughafen-maspalomas",
      "destination": "/taxi-flughafen-maspalomas.html"
    },
    {
      "source": "/taxi-flughafen-puerto-mogan",
      "destination": "/taxi-flughafen-puerto-mogan.html"
    },
    {
      "source": "/taxi-flughafen-puerto-rico",
      "destination": "/taxi-flughafen-puerto-rico.html"
    },
    {
      "source": "/taxi-las-palmas-maspalomas-de",
      "destination": "/taxi-las-palmas-maspalomas-de.html"
    },
    {
      "source": "/taxi-las-palmas-maspalomas-en",
      "destination": "/taxi-las-palmas-maspalomas-en.html"
    },
    {
      "source": "/taxi-las-palmas-maspalomas",
      "destination": "/taxi-las-palmas-maspalomas.html"
    },
    {
      "source": "/taxitarife-gran-canaria",
      "destination": "/taxitarife-gran-canaria.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.basemaps.cartocdn.com; connect-src 'self' https://taya-backend-production-a4c2.up.railway.app wss://taya-backend-production-a4c2.up.railway.app https://*.basemaps.cartocdn.com https://fonts.gstatic.com https://www.cartociudad.es https://nominatim.openstreetmap.org https://photon.komoot.io https://vitals.vercel-insights.com https://accounts.google.com; frame-src https://accounts.google.com; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=(self), payment=()"
        }
      ]
    }
  ]
}
